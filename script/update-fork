#!/usr/bin/env bash

set -euo pipefail

# Pull the latest upstream Zed, rebase this fork's commits on top, then bump
# the patch version and tag the result as batcave-vX.Y.Z.

version_file="crates/zed/Cargo.toml"
tag_prefix="batcave-v"

if [[ -d .git/rebase-merge || -d .git/rebase-apply ]]; then
    echo "A rebase is already in progress. Finish it with 'git rebase --continue' or abort with 'git rebase --abort' first." >&2
    exit 1
fi

git fetch upstream main

git rebase --autostash upstream/main

current=$(grep -m1 '^version = ' "$version_file" | sed -E 's/version = "([0-9]+)\.([0-9]+)\.([0-9]+)"/\1.\2.\3/')
major=${current%%.*}
rest=${current#*.}
minor=${rest%%.*}
patch=${rest#*.}
new_version="$major.$minor.$((patch + 1))"

sed -i '' "s/^version = \"$current\"/version = \"$new_version\"/" "$version_file"
git add "$version_file"
git commit -m "Bump version to $new_version"
git tag "$tag_prefix$new_version"

echo ""
echo "Fork updated to $new_version and tagged $tag_prefix$new_version."
echo "Push with: git push origin main && git push origin $tag_prefix$new_version"